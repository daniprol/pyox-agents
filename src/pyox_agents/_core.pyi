"""Type stubs for the compiled Rust module (`src/*.rs`)."""

from collections.abc import Mapping, Sequence
from typing import Any, Generic, TypeVar, final

from pyox_agents.messages import History, HistoryStore, LoadHistory, Message

@final
class Client:
    """Connection settings and a shared HTTP connection pool."""

    def __init__(
        self,
        api_key: str | None = None,
        *,
        base_url: str | None = None,
        headers: Mapping[str, str] | None = None,
        connect_timeout_seconds: float = 10.0,
        request_timeout_seconds: float | None = 600.0,
        max_retries: int = 2,
    ) -> None: ...
    @property
    def base_url(self) -> str: ...

@final
class BuiltinTool:
    """A tool implemented in Rust inside pyox-agents, selected by name."""

    def __init__(self, name: str) -> None: ...
    @staticmethod
    def available() -> list[str]: ...
    @property
    def name(self) -> str: ...
    @property
    def description(self) -> str: ...

DepsT = TypeVar("DepsT")

@final
class RunContext(Generic[DepsT]):
    """The `ctx` given to tools that ask for it and to hooks."""

    @property
    def deps(self) -> DepsT: ...
    @property
    def conversation_id(self) -> str | None: ...
    @property
    def turn(self) -> int: ...
    @property
    def input_tokens(self) -> int: ...
    @property
    def output_tokens(self) -> int: ...
    @property
    def tool_call_id(self) -> str | None: ...
    @property
    def tool_name(self) -> str | None: ...

@final
class TextDelta:
    @property
    def text(self) -> str: ...

@final
class ToolStarted:
    @property
    def call_id(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def arguments(self) -> Any: ...

@final
class ToolFinished:
    @property
    def call_id(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def result(self) -> str: ...
    @property
    def is_error(self) -> bool: ...

@final
class RunFinished:
    @property
    def text(self) -> str: ...
    @property
    def turns(self) -> int: ...
    @property
    def input_tokens(self) -> int: ...
    @property
    def output_tokens(self) -> int: ...
    @property
    def messages(self) -> list[Message]: ...
    @property
    def new_messages(self) -> list[Message]: ...
    def messages_json(self) -> str: ...
    def new_messages_json(self) -> str: ...

@final
class Run:
    def __aiter__(self) -> Run: ...
    async def __anext__(self) -> TextDelta | ToolStarted | ToolFinished | RunFinished: ...

@final
class Engine:
    def __init__(
        self,
        *,
        client: Client,
        model: str,
        prompt: str = "",
        tools: Sequence[Any] = (),
        model_parameters: Mapping[str, Any] | None = None,
        max_turns: int = 20,
        text_chunks: str | int | None = None,
        history_store: HistoryStore | LoadHistory | None = None,
        hooks: Sequence[object] = (),
    ) -> None: ...
    def execute(
        self,
        prompt: str | None = None,
        *,
        history: History | None = None,
        conversation_id: str | None = None,
        text_chunks: str | int | None = None,
        deps: Any = None,
    ) -> Run: ...

class AgentError(Exception): ...
class ApiError(AgentError): ...
class AuthenticationError(ApiError): ...
class RateLimitError(ApiError): ...
class RequestTimeoutError(AgentError): ...
class NetworkError(AgentError): ...
class InvalidResponseError(AgentError): ...
class MaxTurnsExceededError(AgentError): ...
class HistoryError(AgentError): ...
class HookError(AgentError): ...
